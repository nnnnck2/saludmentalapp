# ============================================
# MenteSana - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores
#
# Para Expo: usa EXPO_PUBLIC_ prefijo para variables públicas
# Para app.json: configura en "expo.extra"

# --- SUPABASE ---
# Obtén estos valores del Dashboard de Supabase: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- AUTENTICACIÓN ---
# Configura los proveedores en Supabase Dashboard > Authentication > Providers

# Google OAuth
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto y configura la pantalla de consentimiento OAuth
# 3. Agrega el Client ID en Supabase Dashboard
EXPO_PUBLIC_GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Apple Sign In (solo iOS)
# 1. Habilita Apple Sign In en tu Apple Developer Account
# 2. Configura en Supabase Dashboard
EXPO_PUBLIC_APPLE_CLIENT_ID=com.mentesana.app

# --- NOTIFICACIONES PUSH ---
# Expo Push Token se genera automáticamente
# Para enviar notificaciones: https://docs.expo.dev/push-notifications/sending-notifications/

# --- API (opcional, para backend personalizado) ---
# EXPO_PUBLIC_API_URL=https://api.mentesana.com

# --- ENTORNO ---
# ENV=development
